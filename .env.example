# AI 解读服务配置
# 复制此文件为 .env.local 并填入你的 API Key

# ─── 方案 A：Anthropic Claude（推荐，质量高） ───────────────────
ANTHROPIC_API_KEY=sk-ant-api03-你的key

# ─── 方案 B：DeepSeek（国内备选，成本低） ───────────────────────
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-你的key

# ─── 可选配置 ──────────────────────────────────────────────────
# AI_PROVIDER=anthropic  # 默认值，可省略
# MAX_TOKENS=2000        # 单次解读最大 token 数
